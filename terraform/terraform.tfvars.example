# CONFIGURACION GENERAL
aws_region   = "us-east-1"
project_name = "cloud-obligatorio"

# BASE DE DATOS
db_username = "cloudadmin"
db_password = "REEMPLAZAR_CON_CONTRASENA_SEGURA"
rds_deletion_protection = true

# MODALIDAD DE DESPLIEGUE
# AWS Academy: false en las tres variables
# AWS estandar: true en las tres variables
create_iam_profile          = false
manage_master_user_password = false
use_native_s3               = false

# PERFIL IAM EXISTENTE (AWS ACADEMY)
ec2_instance_profile_name = "LabInstanceProfile"

# S3 - NOMBRE GLOBALMENTE UNICO
app_bucket_name = "REEMPLAZAR_BUCKET_APP"

# BASTION Y SSH
bastion_ami_id      = "ami-0ed59cbb87dfa8dba"
ssh_public_key_path = "REEMPLAZAR_RUTA_CLAVE_PUBLICA"

# MONITOREO
alert_email = "REEMPLAZAR_CORREO"