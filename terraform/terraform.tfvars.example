
# CONFIGURACION GENERAL

region_aws     = "us-east-1"
nombre_proyecto = "cloud-obligatorio"

# ACCESO SSH

# Reemplazar por la IP publica autorizada para administrar el Bastion.
cidr_ssh_bastion = "REEMPLAZAR_IP_PUBLICA/32"

# Ruta de la clave publica SSH utilizada por el Bastion.
ruta_clave_publica_ssh = "REEMPLAZAR_RUTA_CLAVE_PUBLICA"

# AMI del Bastion, valida para la region seleccionada.
id_ami_bastion = "REEMPLAZAR_AMI_BASTION"

# BASE DE DATOS

usuario_bd  = "cloudadmin"
contrasena_bd = "REEMPLAZAR_CON_CONTRASENA_SEGURA"

administrar_contrasena_maestra_rds = false
proteccion_eliminacion_rds         = true

# ALMACENAMIENTO S3

# Debe ser un nombre globalmente unico.
nombre_bucket_aplicacion = "REEMPLAZAR_BUCKET_APLICACION"

# AWS Academy: false.
# Cuentas con permisos completos para administrar S3: true.
usar_s3_nativo = false

# MONITOREO

correo_alertas = "REEMPLAZAR_CORREO"

# KUBERNETES K3S

habilitar_k3s = true

# Perfil IAM existente utilizado por las instancias K3s en AWS Academy.
nombre_perfil_iam_k3s = "LabInstanceProfile"
